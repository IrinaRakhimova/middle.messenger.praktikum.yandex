<main>
  <p class="back"><a href="/">← Назад</a></p>
  <div class="profile-page">
    <div class="container">
      <div class="avatar-wrapper">
        <img src="{{avatarUrl}}" alt="User Avatar" class="avatar-image" />
        <label for="avatarInput" class="avatar-overlay">Поменять </br>аватар</label>
        <input type="file" id="avatarInput" name="avatar" accept="image/*" hidden />
      </div>
    </div>

    <h1>{{displayName}}</h1>
    <ul class="profile-info">
      <li><strong>Почта</strong>
        <p class="profile-info-text">{{email}}</p>
      </li>
      <li><strong>Логин</strong>
        <p class="profile-info-text">{{login}}</p>
      </li>
      <li><strong>Имя</strong>
        <p class="profile-info-text">{{firstName}}</p>
      </li>
      <li><strong>Фамилия</strong>
        <p class="profile-info-text">{{secondName}}</p>
      </li>
      <li><strong>Имя в чате</strong>
        <p class="profile-info-text">{{displayName}}</p>
      </li>
      <li class="last-li"><strong>Телефон</strong>
        <p class="profile-info-text">{{phone}}</p>
      </li>
    </ul>

    <div class="profile-actions">
      {{{editButton}}}
      {{{passwordButton}}}
      <div class="logout">
        {{{logoutButton}}}
      </div>
    </div>
  </div>
</main>